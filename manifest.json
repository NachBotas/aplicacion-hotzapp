{
  "manifest_version": 3,
  "name": "HotZapp – Respuestas rápidas para WhatsApp Web",
  "short_name": "HotZapp",
  "version": "2.3.0",
  "description": "Respuestas rápidas (texto, audio como nota de voz, imagen, video, documento, contacto y secuencias), CRM, pendientes, notas y mensajes programados para WhatsApp Web.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HotZapp",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/wpp-config.js",
        "lib/wppconnect-wa.js",
        "src/bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/storage.js",
        "src/icons.js",
        "src/wa.js",
        "src/panel-style.js",
        "src/core.js",
        "src/engine.js",
        "src/editor.js",
        "src/sections.js",
        "src/bar.js",
        "src/backup.js",
        "src/tracker.js",
        "src/stats.js",
        "src/deco.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}